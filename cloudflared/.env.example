# =============================================================
# Modelo do .env do cloudflared
# =============================================================
# Copie para .env na VM e preencha:
#
#   cp .env.example .env
#   nano .env
#
# O .env real NAO vai para o repositorio.
# =============================================================

# Token do conector, copiado do painel Zero Trust ao criar o tunel
# (Networks -> Tunnels -> Create a tunnel -> Docker).
#
# Vem no meio de um comando pronto, mais ou menos assim:
#   docker run cloudflare/cloudflared:latest tunnel --no-autoupdate run --token eyJhIjoi...
#
# Copie SO a parte depois de `--token`.
#
# Este token da acesso de conector ao seu tunel: trate como senha.
TUNNEL_TOKEN=COLE_O_TOKEN_AQUI
