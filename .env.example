# =============================================================
# nasFinance - modelo do .env de DESENVOLVIMENTO LOCAL
# =============================================================
# Estes sao os mesmos valores que a aplicacao ja assume por padrao
# (veja application.properties). O arquivo existe para o caso de voce
# querer mudar algum deles sem editar o codigo.
#
# Para o desenvolvimento normal no Windows, NAO e necessario criar
# um .env: basta ter o PostgreSQL 17 rodando na 5432 com o banco
# criado por scripts/create-database.sql.
# =============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nasfinance
DB_USER=nasfinance
DB_PASSWORD=nasfinance

TEST_DB_NAME=nasfinance_test

APP_TIMEZONE=America/Sao_Paulo

# Em desenvolvimento o token padrao ja funciona; sobrescreva apenas se
# quiser testar o fluxo do Atalho com um valor realista.
# SHORTCUT_TOKEN=dev-token-trocar-em-producao
