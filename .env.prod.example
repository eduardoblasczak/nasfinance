# =============================================================
# nasFinance - modelo do .env de PRODUCAO
# =============================================================
# Copie para .env no servidor e preencha:
#
#   cp .env.prod.example .env
#   nano .env
#
# O .env real NAO vai para o repositorio (esta no .gitignore).
# =============================================================

# ---- Banco de dados ----
DB_NAME=nasfinance
DB_USER=nasfinance
# Gere com:  openssl rand -base64 24
DB_PASSWORD=TROCAR_POR_SENHA_FORTE

# ---- Porta no host ----
# Confirme que esta livre ANTES de subir:
#   sudo ss -tulpn | grep -w 8092
# Ja em uso no nas-server: 8090 (Draft), 8091 (wake-api).
APP_PORT=8092

# ---- Token do Atalho do iPhone ----
# Protege POST /api/v1/quick-entry. A aplicacao SE RECUSA A SUBIR se este
# valor for o token de desenvolvimento ou tiver menos de 24 caracteres.
# Gere com:  openssl rand -hex 32
SHORTCUT_TOKEN=TROCAR_POR_TOKEN_GERADO

# ---- Fuso horario ----
# Define o que a aplicacao considera "hoje" ao registrar um lancamento sem
# data. O container roda em UTC; sem isto, uma compra as 22h cairia no dia
# seguinte.
APP_TIMEZONE=America/Sao_Paulo
